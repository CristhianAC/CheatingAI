# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=CheatingAI - Plagiarism Detection API
APP_VERSION=1.0.0
DEBUG=false

# ── Base de datos ──────────────────────────────────────────────────────────────
# SQLite para desarrollo local
DATABASE_URL=sqlite:///./data/cheating_ai.db

# PostgreSQL para producción (descomentar y configurar si se migra)
# DATABASE_URL=postgresql://user:password@localhost:5432/cheating_ai

# ── Redis / Celery ─────────────────────────────────────────────────────────────
# En Docker Compose el hostname es "redis"
REDIS_URL=redis://redis:6379/0

# En desarrollo local sin Docker
# REDIS_URL=redis://localhost:6379/0

# ── Algoritmo Winnowing ────────────────────────────────────────────────────────
# Tamaño del k-gram (tokens por subsecuencia)
WINNOWING_K=5

# Tamaño de la ventana deslizante
WINNOWING_W=4

# Umbral de similitud por defecto para marcar como plagio (0.0 - 1.0)
DEFAULT_THRESHOLD=0.7
