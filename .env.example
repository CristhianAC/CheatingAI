# Copia este archivo a `.env` en la raíz del repo (junto a docker-compose.yml).
# No commitees `.env` — contiene contraseñas y claves.

# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=CheatingAI - Plagiarism Detection API
APP_VERSION=1.0.0
DEBUG=false

# ── Base de datos ──────────────────────────────────────────────────────────────
# Usada por los servicios `api` (8000) y `proctoring` (8001) vía docker-compose.

# --- Opción A: SQLite (desarrollo local sin Supabase) ---
# DATABASE_URL=sqlite:///./data/cheating_ai.db

# --- Opción B: Supabase DIRECTA (recomendada para desarrollo con Docker) ---
# Dashboard → Settings → Database → Connection string → "URI" / Direct connection
# Usuario: postgres (sin sufijo .ref). Host: db.[PROJECT-REF].supabase.co
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# --- Opción C: Supabase POOLER — modo Session (muchas conexiones cortas) ---
# Dashboard → Connection pooling → Session mode
# Usuario: postgres.[PROJECT-REF]  |  Puerto: 5432  |  Host: aws-*-[region].pooler.supabase.com
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# --- Opción D: Supabase POOLER — modo Transaction (serverless / ORMs) ---
# Puerto: 6543 (no 5432). Misma región y PROJECT-REF que en el dashboard.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Si la contraseña tiene @ # % & etc., codifícala en URL (el dashboard suele dar la URI ya codificada).
# Error "tenant/user postgres.xxx not found" → URI incorrecta, proyecto pausado o ref/región distinta al dashboard.

# JWT (auth)
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Supabase Storage ───────────────────────────────────────────────────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=proctoring-violations
SUPABASE_VIOLATION_CAPTURES_BUCKET=violation-captures
SUPABASE_PROFILE_BUCKET=profile-photos

# ── Redis / Celery ─────────────────────────────────────────────────────────────
# En Docker Compose el hostname es "redis"
REDIS_URL=redis://redis:6379/0

# En desarrollo local sin Docker
# REDIS_URL=redis://localhost:6379/0

# ── Algoritmo Winnowing ────────────────────────────────────────────────────────
WINNOWING_K=5
WINNOWING_W=4
DEFAULT_THRESHOLD=0.7

# ── Verificación tras configurar .env ─────────────────────────────────────────
# docker compose up --build redis api proctoring
# curl -s -o /dev/null -w "%{http_code}" http://localhost:8000/docs   # esperado: 200
