#Ya no es necesario usar .env.example
# ── Aplicación ────────────────────────────────────────────────────────────────
APP_NAME=CheatingAI - Plagiarism Detection API
APP_VERSION=1.0.0
DEBUG=false

# ── Base de datos ──────────────────────────────────────────────────────────────
# SQLite para desarrollo local (opcional)
# DATABASE_URL=sqlite:///./data/cheating_ai.db

# PostgreSQL (Supabase o propio). En Docker conviene usar esta.
# Driver: usar postgresql:// o postgresql+psycopg2://
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Conexión directa (opcional, para migraciones)
# DIRECT_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# ── Supabase Storage (solo proctoring: capturas de violaciones) ───────────────
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here
SUPABASE_BUCKET=proctoring-violations

# ── Redis / Celery ─────────────────────────────────────────────────────────────
# En Docker Compose el hostname es "redis"
REDIS_URL=redis://redis:6379/0

# En desarrollo local sin Docker
# REDIS_URL=redis://localhost:6379/0

# ── Algoritmo Winnowing ────────────────────────────────────────────────────────
# Tamaño del k-gram (tokens por subsecuencia)
WINNOWING_K=5

# Tamaño de la ventana deslizante
WINNOWING_W=4

# Umbral de similitud por defecto para marcar como plagio (0.0 - 1.0)
DEFAULT_THRESHOLD=0.7
